# nginx site config for kra.aumraj.in
# Install: sudo cp infra/nginx/kra.aumraj.in.conf.template /etc/nginx/sites-available/kra.aumraj.in
#          sudo ln -sf /etc/nginx/sites-available/kra.aumraj.in /etc/nginx/sites-enabled/
#          sudo nginx -t && sudo systemctl reload nginx
#
# Recommended: add these to the global http {} block in /etc/nginx/nginx.conf if not present:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
#
# HTTPS: run certbot after installing this config:
#   sudo certbot --nginx -d kra.aumraj.in -d www.kra.aumraj.in
#
# Legacy note: the old server had a duplicate server block proxying to :10929
# with the same server_name. That block was removed — only :5500 is used.

server {
    listen 80;
    server_name kra.aumraj.in www.kra.aumraj.in;

    client_max_body_size 20M;

    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml;
    gzip_disable "MSIE [1-6]\.";

    location / {
        proxy_pass http://127.0.0.1:5500;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
    }
}
