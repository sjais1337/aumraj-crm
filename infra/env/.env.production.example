NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=https://kra.aumraj.in
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:5500
NODE_ENV=production
PORT=5500
